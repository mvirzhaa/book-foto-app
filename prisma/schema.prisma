// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // Ini wajib ada karena kita pakai adapter
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  nim           String         @unique
  name          String
  prodi         String?        // <-- Kolom baru (opsional)
  fakultas      String?        // <-- Kolom baru (opsional)
  angkatan      String?        // <-- Kolom baru (opsional)
  password      String
  role          Role           @default(STUDENT)
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Registration {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  type             PhotoType
  method           SubmissionMethod
  photoUrl         String?
  status           Status           @default(PENDING)
  fileUrl          String? 
  bookingDate      DateTime?  
  bookingTime      String? 
  adminNotes       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum Role {
  STUDENT
  ADMIN
}

enum PhotoType {
  KTM
  IJAZAH
}

enum SubmissionMethod {
  UPLOAD
  STUDIO_BOOKING
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

// Tambahkan di bagian bawah prisma/schema.prisma

model Fakultas {
  id    String  @id @default(uuid())
  nama  String  @unique
  prodi Prodi[] // Relasi: Satu Fakultas punya banyak Prodi
}

model Prodi {
  id         String   @id @default(uuid())
  nama       String
  fakultasId String
  fakultas   Fakultas @relation(fields: [fakultasId], references: [id], onDelete: Cascade)
}

model Angkatan {
  id    String @id @default(uuid())
  tahun String @unique
}